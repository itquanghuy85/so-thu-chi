<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all API calls to the Sổ Thu Chi backend (dio/http),
         including release builds (debug/profile manifests already grant it
         automatically via the Flutter template). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Fingerprint / Face unlock for the PIN app-lock screen (Mục 14). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- On-device speech-to-text for voice transaction entry (Mục 10). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- connectivity_plus: detects online/offline transitions for the
         offline-first sync queue (Mục 14 offline mode). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Required on Android 13+ to actually display push notifications
         (Mục — "Thông báo đẩy"); requested at runtime via
         FirebaseMessaging.instance.requestPermission(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Excel export → Tải xuống: only needed pre-scoped-storage (Android 9
         and below); Android 10+ writes via MediaStore instead, which needs
         no permission. See MainActivity.kt's saveToDownloads. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <application
        android:label="Sổ Thu Chi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Default icon/channel FCM uses to auto-display a system-tray
             notification while the app is backgrounded/terminated (see
             PushNotificationService doc comment — this is the only path
             for those states, flutter_local_notifications only covers the
             foreground case). Channel id must match the one created in
             PushNotificationService.initialize. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- speech_to_text (Mục 10): lets the app see the device's speech
             recognition service on Android 11+ package-visibility rules. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>
</manifest>
