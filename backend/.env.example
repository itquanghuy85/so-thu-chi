NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=moneyflow
DB_PASSWORD=moneyflow
DB_NAME=moneyflow

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Firebase Auth (Google/Apple sign-in verification). Download a service
# account key from Firebase Console → Project settings → Service accounts,
# save it as backend/firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# --- Cloud deploy only (see "Deploying to the cloud" in README.md) ---
# Managed Postgres hosts (Neon, Render, Supabase, ...) hand out one
# connection string instead of the discrete DB_* vars above — set this
# instead and leave DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME unset.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true
# Paste the *entire contents* of the service account JSON file as one env
# var instead of FIREBASE_SERVICE_ACCOUNT_PATH — cloud hosts build straight
# from the git repo, which never has the (git-ignored) file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
