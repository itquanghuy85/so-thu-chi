NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=moneyflow
DB_PASSWORD=moneyflow
DB_NAME=moneyflow

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Firebase Auth (Google/Apple sign-in verification). Download a service
# account key from Firebase Console → Project settings → Service accounts,
# save it as backend/firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
